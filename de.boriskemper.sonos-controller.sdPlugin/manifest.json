{
	"Name": "SONOS-Controller",
	"Version": "0.4.3.0",
	"Author": "Boris Kemper",
	"Actions": [
		{
			"Name": "Play/Pause",
			"UUID": "de.boriskemper.sonos-controller.play-pause-key",
			"Icon": "imgs/actions/play-pause-key/icon",
			"Tooltip": "Toggle Play/Pause with cover art and title animation.",
			"PropertyInspectorPath": "ui/play-pause-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/play-pause-key/icon"
				}
			]
		},
		{
			"Name": "Play Favorite",
			"UUID": "de.boriskemper.sonos-controller.play-favorite-key",
			"Icon": "imgs/actions/play-favorite-key/icon",
			"Tooltip": "Plays a selected SONOS favorite.",
			"PropertyInspectorPath": "ui/play-favorite-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/play-favorite-key/icon"
				}
			]
		},
		{
			"Name": "Playback Control",
			"UUID": "de.boriskemper.sonos-controller.playback-control-key",
			"Icon": "imgs/actions/playback-control-key/icon",
			"Tooltip": "Provides playback controls like next, previous, etc.",
			"PropertyInspectorPath": "ui/playback-control-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/playback-control-key/icon"
				}
			]
		},
		{
			"Name": "Volume Control",
			"UUID": "de.boriskemper.sonos-controller.volume-control-key",
			"Icon": "imgs/actions/volume-control-key/icon",
			"Tooltip": "Control SONOS volume with a key.",
			"PropertyInspectorPath": "ui/volume-control-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Name": "Unmuted",
					"Image": "imgs/actions/volume-control-key/icon"
				},
				{
					"Name": "Muted",
					"Image": "imgs/actions/volume-control-key/icon-muted"
				}
			]
		},
		{
			"Name": "Multi-Control",
			"UUID": "de.boriskemper.sonos-controller.multi-control-key",
			"Icon": "imgs/actions/multi-control-key/icon",
			"Tooltip": "Line-In, battery status, and more SONOS device functions on one key.",
			"PropertyInspectorPath": "ui/multi-control-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/multi-control-key/icon"
				}
			]
		},
		{
			"Name": "Volume",
			"UUID": "de.boriskemper.sonos-controller.volume-dial",
			"Icon": "imgs/actions/volume-dial/icon",
			"Tooltip": "Control SONOS volume with a dial.",
			"PropertyInspectorPath": "ui/volume-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Push": "Mute",
					"Rotate": "Adjust Volume",
					"Touch": "Recall preset (hold: save preset)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/volume-dial/icon"
				}
			]
		},
		{
			"Name": "Group Volume",
			"UUID": "de.boriskemper.sonos-controller.group-volume-dial",
			"Icon": "imgs/actions/group-volume-dial/icon",
			"Tooltip": "Control the volume of an entire SONOS group with a dial.",
			"PropertyInspectorPath": "ui/group-volume-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Push": "Mute group",
					"Rotate": "Adjust group volume",
					"Touch": "Recall group preset (hold: save preset)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/group-volume-dial/icon"
				}
			]
		},
		{
			"Name": "Favorites",
			"UUID": "de.boriskemper.sonos-controller.favorites-dial",
			"Icon": "imgs/actions/favorites-dial/icon",
			"Tooltip": "Browse and play your personal Sonos favorites list.",
			"PropertyInspectorPath": "ui/favorites-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Push": "Play selected favorite",
					"Rotate": "Browse favorites list",
					"Touch": "Return to now playing"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/favorites-dial/icon"
				}
			]
		},
		{
			"Name": "Panorama Effects",
			"UUID": "de.boriskemper.sonos-controller.panorama-effects-dial",
			"Icon": "imgs/actions/panorama-effects-dial/icon",
			"Tooltip": "Visual effect animation spanning up to 4 LCD panels as one continuous scene.",
			"PropertyInspectorPath": "ui/panorama-effects-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$A0",
				"TriggerDescription": {
					"Push": "Toggle effect parameter mode",
					"Rotate": "Adjust effect parameter",
					"Touch": "None"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/panorama-effects-dial/icon"
				}
			]
		},
		{
			"Name": "Track Control",
			"UUID": "de.boriskemper.sonos-controller.track-control-dial",
			"Icon": "imgs/actions/track-control-dial/icon",
			"Tooltip": "Displays current track info and controls volume.",
			"PropertyInspectorPath": "ui/track-control-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$A0",
				"TriggerDescription": {
					"Push": "Skip to next track",
					"Rotate": "Seek ±5% in track",
					"Touch": "Toggle Play/Pause"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/track-control-dial/icon"
				}
			]
		},
		{
			"Name": "Queue",
			"UUID": "de.boriskemper.sonos-controller.queue-dial",
			"Icon": "imgs/actions/queue-dial/icon",
			"Tooltip": "Browse and jump within the current playlist/queue; shows a now-playing card for radio.",
			"PropertyInspectorPath": "ui/queue-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$A0",
				"TriggerDescription": {
					"Push": "Jump to selected track",
					"Rotate": "Browse queue",
					"Touch": "Cancel browse"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/queue-dial/icon"
				}
			]
		},
		{
			"Name": "Diagnostics",
			"UUID": "de.boriskemper.sonos-controller.diagnostics-dial",
			"Icon": "imgs/actions/diagnostics-dial/icon",
			"Tooltip": "Nerdy WiFi connection diagnostics sparkline for a SONOS speaker (unofficial, may break with firmware updates).",
			"PropertyInspectorPath": "ui/diagnostics-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$A0",
				"TriggerDescription": {
					"Push": "Cycle metric",
					"Rotate": "Scroll metric",
					"Touch": "Refresh now"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/diagnostics-dial/icon"
				}
			]
		}
	],
	"Category": "SONOS-Controller",
	"CategoryIcon": "imgs/plugin/lobster",
	"CodePath": "bin/plugin.js",
	"Description": "Control your SONOS system with your StreamDeck+\nThis plugin is not connected to SONOS.\n\nThis plugin uses SONOS-TS by Stephan van Rooij (https://sonos-ts.svrooij.io/), licensed under MIT License.\n\nIcons by\nhttps://pictogrammers.com\n\nsdpi-components by GeekyEggo\nhttps://github.com/geekyeggo/sdpi-components",
	"Icon": "imgs/plugin/lobster",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"UUID": "de.boriskemper.sonos-controller"
}
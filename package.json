{
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart de.boriskemper.sonos-controller\"",
        "icons": "node tools/generate-icons.mjs",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "test": "vitest run",
        "effects:preview": "node tools/run-effects-preview.mjs",
        "version:patch": "node tools/bump-version.mjs patch",
        "version:minor": "node tools/bump-version.mjs minor",
        "version:major": "node tools/bump-version.mjs major",
        "version:beta": "node tools/bump-version.mjs beta",
        "release": "node tools/release.mjs",
        "ship:patch": "npm run lint && npm run test && npm run build && npm run version:patch && npm run release",
        "ship:minor": "npm run lint && npm run test && npm run build && npm run version:minor && npm run release",
        "ship:major": "npm run lint && npm run test && npm run build && npm run version:major && npm run release",
        "ship:beta": "npm run lint && npm run test && npm run build && npm run version:beta && npm run release"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.7.4",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.9",
        "@types/node": "~20.15.0",
        "@types/opentype.js": "^1.3.10",
        "eslint": "^10.6.0",
        "gif-encoder-2": "^1.0.5",
        "rollup": "^4.62.2",
        "rollup-plugin-copy": "^3.5.0",
        "topojson-client": "^3.1.0",
        "tslib": "^2.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vitest": "^4.1.10",
        "world-atlas": "^2.0.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.0",
        "@mdi/js": "^7.4.47",
        "@svrooij/sonos": "^2.7.0-beta.4",
        "opentype.js": "^2.0.0",
        "sharp": "^0.35.2"
    }
}
